# QuickNews 环境变量配置（ClawCloud 部署用）

# ==================== 数据库配置 ====================
# MySQL 配置（ClawCloud 自建 MySQL）
DB_HOST=mysql
DB_PORT=3306
DB_USER=quicknews
DB_PASSWORD=QuickNews@2026
DB_NAME=quicknews_maindb

# MySQL Root 密码（仅用于首次初始化）
MYSQL_ROOT_PASSWORD=QuickNews@2026

# ==================== Flask 配置 ====================
FLASK_ENV=production
FLASK_APP=news_dashboard/ir/xml_api.py
TZ=Asia/Shanghai

# ==================== NewsAPI 配置 ====================
# 用于抓取新闻（可选，但建议配置）
NEWSAPI_KEY=your_newsapi_key_here

# ==================== 可选：调试配置 ====================
# DEBUG=true
# LOG_LEVEL=INFO
